package(default_visibility = ["//visibility:public"])

cc_library(
    name = "sdl2",
    srcs = [
        "x86_64-w64-mingw32/lib/libSDL2.a",
    ],
    includes = ["x86_64-w64-mingw32/include"],
    alwayslink = 1,
)

cc_library(
    name = "sdl2main",
    srcs = [
        "x86_64-w64-mingw32/lib/libSDL2main.a",
    ],
    alwayslink = 1,
)