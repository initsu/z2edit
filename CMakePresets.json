{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-mingw",
      "displayName": "Windows - MinGW (native)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-static-debug",
      "displayName": "Windows - MSVC (static, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-static-release",
      "displayName": "Windows - MSVC (static, Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-mingw-cross",
      "displayName": "Windows - MinGW cross (llvm-mingw from Linux/WSL)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw-cross",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm-mingw.cmake",
      "cacheVariables": {
        "Z2EDIT_WINDOWS_CROSS": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-mingw", "configurePreset": "windows-mingw" },
    { "name": "windows-mingw-cross", "configurePreset": "windows-mingw-cross" },
    {
      "name": "windows-msvc-static-debug",
      "displayName": "Visual Studio Debug",
      "configurePreset": "windows-msvc-static-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-static-release",
      "displayName": "Visual Studio Release",
      "configurePreset": "windows-msvc-static-release",
      "configuration": "Release"
    },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "macos", "configurePreset": "macos" }
  ]
}